# NODE ENVIRONMENT
NODE_ENV=development

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=ws://localhost:5000
NEXT_PUBLIC_APP_NAME=ELISA OS
NEXT_PUBLIC_APP_VERSION=1.0.0

# BACKEND
PORT=5000
BACKEND_URL=http://localhost:5000

# DATABASE
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=elisa_user
DATABASE_PASSWORD=secure_password_123
DATABASE_NAME=elisa_os
DATABASE_URL=postgresql://elisa_user:secure_password_123@localhost:5432/elisa_os

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_123
REDIS_URL=redis://:redis_password_123@localhost:6379

# AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# AI & OPENAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# CLOUDFLARE
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
CLOUDFLARE_DOMAIN=elisa-os.dev

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@elisa-os.dev

# STORAGE
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif,mp4,mp3

# SECURITY
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,elisa-os.dev

# LOGGING
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_FORMAT=json
